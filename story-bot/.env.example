# Copy to .env and fill in. Never commit .env.
SITE_URL=https://casavellarural.com
# The same value as STORY_BOT_SECRET in Cloudflare Pages
STORY_BOT_SECRET=
IG_USERNAME=casavellarural
IG_PASSWORD=
# Only if the account has two-factor authentication with an app: the setup key Instagram shows (not a 6-digit code)
IG_TOTP_SECRET=
# Only when it runs on a server and not at home: a residential proxy, http://user:pass@host:port
IG_PROXY=
